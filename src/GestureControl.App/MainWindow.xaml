<Window x:Class="GestureControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MVPGesture Studio — Control de Gestos en Tiempo Real (.NET 10)" 
        Height="820" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#0F111A"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#88C0D0"/>
            <Setter Property="BorderBrush" Value="#2E3440"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B4252"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6">
                <Border x:Name="SplitBorder" 
                        Width="26" 
                        HorizontalAlignment="Right" 
                        Margin="0" 
                        BorderThickness="0">
                    <Path x:Name="Arrow" 
                          Data="F1 M 0,0 L 4,4 L 8,0 Z" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Fill="#88C0D0"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#88C0D0"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#ECEFF4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- High-Contrast Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#24283B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#414868"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide" 
                                   Focusable="False">
                                <Border x:Name="DropDownBorder" 
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        Background="#1A1B26" 
                                        BorderBrush="#414868" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Margin="0,3,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.6" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas Height="0" Width="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Rectangle x:Name="OpaqueRect" Height="{Binding ActualHeight, ElementName=DropDownBorder}" Width="{Binding ActualWidth, ElementName=DropDownBorder}" Fill="#1A1B26"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Grid.Column="0" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" 
                                          Template="{StaticResource ComboBoxToggleButton}"/>

                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#565F89"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#7AA2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Contrast Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#1A1B26"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" 
                                Padding="{TemplateBinding Padding}" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Margin="2,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F354A"/>
                                <Setter Property="Foreground" Value="#7AA2F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D59A1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & UIPI Warning Banner -->
        <Border Grid.Row="0" Background="#1A1C28" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="#2E3440" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖐️ MVPGesture Studio" FontWeight="Bold" FontSize="18" Foreground="#88C0D0" VerticalAlignment="Center"/>
                        <Border Background="#2E3440" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Fase 2: MVP Usable • .NET 10 • Zero-Alloc Span" FontSize="11" Foreground="#81A1C1"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtUipiStatus" Text="🛡️ UIPI: Proceso en ejecución estándar. (Permisos OK)" FontSize="12" Foreground="#A3BE8C" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Control Buttons (Mouse Tracking Toggle + Start/Stop Pipeline) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleMouseTracking" Content="🖱️ Mouse: ACTIVO [F8]" Click="BtnToggleMouseTracking_Click"
                            Width="190" Height="38" Background="#10B981" Foreground="White" FontWeight="SemiBold" FontSize="13"
                            Margin="0,0,10,0" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnStartStop" Content="▶ Iniciar Pipeline" Click="BtnStartStop_Click"
                            Width="160" Height="38" Background="#5E81AC" Foreground="White" FontWeight="SemiBold" FontSize="14"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Left: Video, HUD, Log; Right: Settings & Profiles) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="640"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Video Canvas, Telemetry Cards & In-App Console -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="380"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Camera Preview with Skeleton Overlay -->
                <Border Grid.Row="0" Background="#161822" CornerRadius="8" BorderBrush="#2E3440" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="GridVideoContainer" Width="640" Height="480">
                                <Image x:Name="ImgVideoPreview" Width="640" Height="480" Stretch="Fill" />
                                <Canvas x:Name="CanvasSkeleton" Width="640" Height="480" IsHitTestVisible="False" />
                            </Grid>
                        </Viewbox>

                        <!-- Top-Right Mode Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#A0000000" CornerRadius="4" Padding="6,3">
                            <TextBlock x:Name="TxtTrackerEngine" Text="ONNX MediaPipe Hand" FontSize="11" Foreground="#A3BE8C" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Telemetry HUD Cards & Prominent Instant Gesture Label -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Latency SLA Card -->
                    <Border Grid.Column="0" Background="#1A1C28" CornerRadius="6" Padding="8" BorderBrush="#2E3440" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LATENCIA" FontSize="10" Foreground="#D8DEE9" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtLatency" Text="-- ms" FontSize="17" FontWeight="Bold" Foreground="#A3BE8C" Margin="0,2,0,0"/>
                            <TextBlock Text="SLA &lt; 80 ms" FontSize="9" Foreground="#4C566A"/>
                        </StackPanel>
                    </Border>

                    <!-- FPS Card -->
                    <Border Grid.Column="2" Background="#1A1C28" CornerRadius="6" Padding="8" BorderBrush="#2E3440" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CADENCIA" FontSize="10" Foreground="#D8DEE9" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtFps" Text="-- FPS" FontSize="17" FontWeight="Bold" Foreground="#88C0D0" Margin="0,2,0,0"/>
                            <TextBlock Text="Meta: 30-60" FontSize="9" Foreground="#4C566A"/>
                        </StackPanel>
                    </Border>

                    <!-- Prominent Real-Time Instant Gesture Label -->
                    <Border Grid.Column="4" Background="#1A1C28" CornerRadius="6" Padding="10,6" BorderBrush="#3B4252" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtGestureIcon" Text="✋" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="GESTO EN TIEMPO REAL:" FontSize="9" Foreground="#81A1C1" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtGesture" Text="Esperando mano..." FontSize="15" FontWeight="Bold" Foreground="#EBCB8B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtEngineState" Text="Estado: Esperando inicio" FontSize="10" Foreground="#4C566A" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#24283B" CornerRadius="4" Padding="6,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtConfidenceBadge" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#88C0D0"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- In-App Real-Time Console / Log -->
                <Border Grid.Row="4" Background="#12131C" CornerRadius="6" BorderBrush="#2E3440" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Log Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📟 CONSOLA DE TELEMETRÍA EN VIVO" FontSize="11" FontWeight="Bold" Foreground="#81A1C1"/>
                                <CheckBox x:Name="ChkVerboseLog" Content="Fotograma a fotograma (Detallado)" IsChecked="False" Margin="14,0,0,0" FontSize="10" Foreground="#D8DEE9" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" Margin="10,0,0,0" FontSize="10" Foreground="#D8DEE9" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnClearLog" Content="Limpiar" Click="BtnClearLog_Click" FontSize="10" Margin="0,0,6,0" Padding="6,2"/>
                                <Button x:Name="BtnCopyLog" Content="Copiar" Click="BtnCopyLog_Click" FontSize="10" Padding="6,2"/>
                            </StackPanel>
                        </Grid>

                        <!-- Log ListBox -->
                        <ListBox Grid.Row="1" x:Name="LstConsoleLog" Background="#0C0D14" BorderBrush="#1F2335" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="11" Foreground="#A9B1D6" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Settings, Calibration & Profiles -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,0,4,0">

                    <!-- Profile Selector & Persistence -->
                    <GroupBox Header="PERFILES Y PERSISTENCIA JSON">
                        <StackPanel>
                            <TextBlock Text="Perfil Activo:" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbProfiles" Height="32" SelectionChanged="CmbProfiles_SelectionChanged"/>
                            <CheckBox x:Name="ChkAutoSwitch" Content="Auto-detectar ventana en primer plano" IsChecked="True" Margin="0,8,0,8" Foreground="#D8DEE9" Checked="ChkAutoSwitch_Changed" Unchecked="ChkAutoSwitch_Changed"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnSaveProfile" Content="💾 Guardar JSON" Click="BtnSaveProfile_Click" FontWeight="SemiBold" Background="#4C566A"/>
                                <Button Grid.Column="2" x:Name="BtnReloadProfiles" Content="🔄 Recargar" Click="BtnReloadProfiles_Click" Background="#3B4252"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Real-Time Calibration (Safety & Intent) -->
                    <GroupBox Header="CALIBRACIÓN EN TIEMPO REAL (SAFETY &amp; INTENT)">
                        <StackPanel>
                            <!-- Dead Zone -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Zona Muerta (Dead Zone):" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtDeadZoneVal" Text="0.015" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldDeadZone" Minimum="0.005" Maximum="0.05" Value="0.015" SmallChange="0.001" LargeChange="0.005" ValueChanged="SldDeadZone_ValueChanged"/>

                            <!-- Mouse Multiplier -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sensibilidad Ratón:" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtSensitivityVal" Text="1.5x" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldSensitivity" Minimum="0.5" Maximum="4.0" Value="1.5" SmallChange="0.1" LargeChange="0.5" ValueChanged="SldSensitivity_ValueChanged"/>

                            <!-- Smoothing Alpha -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Suavizado EMA (Alpha):" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtSmoothingVal" Text="0.65" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldSmoothing" Minimum="0.1" Maximum="0.9" Value="0.65" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldSmoothing_ValueChanged"/>

                            <!-- Hold Duration -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Duración Mínima (Hold):" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtHoldVal" Text="120 ms" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldHold" Minimum="50" Maximum="400" Value="120" SmallChange="10" LargeChange="50" ValueChanged="SldHold_ValueChanged"/>

                            <!-- Dynamic Swipe Distance -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distancia Mínima Swipe:" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtSwipeDistVal" Text="0.15" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldSwipeDist" Minimum="0.05" Maximum="0.35" Value="0.15" SmallChange="0.01" LargeChange="0.05" ValueChanged="SldSwipeDist_ValueChanged"/>

                            <!-- Dynamic Swipe Velocity -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Velocidad Mínima Swipe:" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtSwipeVelVal" Text="0.40 u/s" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldSwipeVel" Minimum="0.20" Maximum="1.50" Value="0.40" SmallChange="0.05" LargeChange="0.20" ValueChanged="SldSwipeVel_ValueChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Visual Options & Floating HUD -->
                    <GroupBox Header="VISUALIZACIÓN Y OVERLAY FLOTANTE">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableMouseTracking" Content="🖱️ Seguimiento de Mouse por Mano (F8)" IsChecked="True" Margin="0,4,0,4" Foreground="#10B981" FontWeight="SemiBold" Checked="ChkEnableMouseTracking_Changed" Unchecked="ChkEnableMouseTracking_Changed"/>
                            <CheckBox x:Name="ChkShowOverlay" Content="Superponer Esqueleto 3D (21 Landmarks)" IsChecked="True" Margin="0,4,0,4" Foreground="#D8DEE9"/>
                            <CheckBox x:Name="ChkFloatingHud" Content="🪟 Activar HUD Flotante (Click-Through)" IsChecked="True" Margin="0,4,0,4" Foreground="#38BDF8" FontWeight="SemiBold" Checked="ChkFloatingHud_Changed" Unchecked="ChkFloatingHud_Changed"/>
                            <CheckBox x:Name="ChkEnableInput" Content="Habilitar Emisión SendInput (Control Real SO)" IsChecked="True" Margin="0,4,0,4" Foreground="#A3BE8C" FontWeight="SemiBold" Checked="ChkEnableInput_Changed" Unchecked="ChkEnableInput_Changed"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Quick Reference of 10 Gestures -->
                    <GroupBox Header="CATÁLOGO DE 10 GESTOS DISPONIBLES">
                        <StackPanel TextElement.FontSize="11">
                            <TextBlock Text="🖐️ Palma / Index: Movimiento Continuo de Ratón" Foreground="#88C0D0" FontWeight="SemiBold" Margin="0,1.5"/>
                            <TextBlock Text="🤚 Lateral Palm: Embrague / Pausa de Ratón" Foreground="#EBCB8B" FontWeight="SemiBold" Margin="0,1.5"/>
                            <TextBlock Text="👌 Pinch: Clic Izquierdo (Click-Freeze anti-jitter)" Foreground="#D8DEE9" Margin="0,1.5"/>
                            <TextBlock Text="✊ Fist: Clic Central / Órbita 3D" Foreground="#D8DEE9" Margin="0,1.5"/>
                            <TextBlock Text="✌️ Two Fingers: Clic Derecho" Foreground="#D8DEE9" Margin="0,1.5"/>
                            <TextBlock Text="🖐️ Open Hand (Hold 1s): Activar / Pausar Sistema" Foreground="#88C0D0" Margin="0,1.5"/>
                            <Separator Background="#2E3440" Margin="0,4"/>
                            <TextBlock Text="👈 Swipe Left: Navegar Atrás / Deshacer" Foreground="#EBCB8B" Margin="0,1.5"/>
                            <TextBlock Text="👉 Swipe Right: Navegar Adelante / Rehacer" Foreground="#EBCB8B" Margin="0,1.5"/>
                            <TextBlock Text="👆 Swipe Up: Re Pág / Zoom In" Foreground="#EBCB8B" Margin="0,1.5"/>
                            <TextBlock Text="👇 Swipe Down: Av Pág / Zoom Out" Foreground="#EBCB8B" Margin="0,1.5"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Footer Status -->
        <Border Grid.Row="2" Background="#161822" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatusMessage" Text="Sistema listo para iniciar captura." FontSize="11" Foreground="#4C566A"/>
                <TextBlock Text="MVPGesture v2.0.0-fase2 • 10 Gestos • Click-Through HUD • .NET 10" HorizontalAlignment="Right" FontSize="11" Foreground="#4C566A"/>
            </Grid>
        </Border>
    </Grid>
</Window>
