<Window x:Class="GestureControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MVPGesture — Control de Gestos en Tiempo Real (.NET 10)" 
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F111A"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#88C0D0"/>
            <Setter Property="BorderBrush" Value="#2E3440"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & UIPI Warning Banner -->
        <Border Grid.Row="0" Background="#1A1C28" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" BorderBrush="#2E3440" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🖐️ MVPGesture Studio" FontWeight="Bold" FontSize="18" Foreground="#88C0D0" VerticalAlignment="Center"/>
                        <Border Background="#2E3440" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text=".NET 10 • Zero-Alloc Span • Win32 SendInput" FontSize="11" Foreground="#81A1C1"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtUipiStatus" Text="🛡️ UIPI: Proceso en ejecución estándar. (Permisos OK)" FontSize="12" Foreground="#A3BE8C" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Start/Stop Primary Button -->
                <Button Grid.Column="1" x:Name="BtnStartStop" Content="▶ Iniciar Pipeline" Click="BtnStartStop_Click"
                        Width="160" Height="38" Background="#5E81AC" Foreground="White" FontWeight="SemiBold" FontSize="14"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Main Workspace (Left: Video & Telemetry, Right: Controls & Settings) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="640"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Video Canvas & Telemetry Cards -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="480"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Camera Preview with Skeleton Canvas Overlay -->
                <Border Grid.Row="0" Background="#161822" CornerRadius="8" BorderBrush="#2E3440" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <!-- Video Frame -->
                        <Image x:Name="ImgVideoPreview" Stretch="Uniform" />

                        <!-- Hand Skeleton Overlay Canvas -->
                        <Canvas x:Name="CanvasSkeleton" Width="640" Height="480" IsHitTestVisible="False" />

                        <!-- Top-Right Mode Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#80000000" CornerRadius="4" Padding="8,4">
                            <TextBlock x:Name="TxtTrackerEngine" Text="ONNX Mode" FontSize="11" Foreground="#EBCB8B" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Telemetry HUD Cards -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Latency SLA Card (<80ms goal) -->
                    <Border Grid.Column="0" Background="#1A1C28" CornerRadius="6" Padding="10" BorderBrush="#2E3440" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LATENCIA TOTAL" FontSize="10" Foreground="#D8DEE9" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtLatency" Text="-- ms" FontSize="20" FontWeight="Bold" Foreground="#A3BE8C" Margin="0,4,0,0"/>
                            <TextBlock Text="Meta SLA: &lt; 80 ms" FontSize="10" Foreground="#4C566A"/>
                        </StackPanel>
                    </Border>

                    <!-- FPS Card -->
                    <Border Grid.Column="2" Background="#1A1C28" CornerRadius="6" Padding="10" BorderBrush="#2E3440" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CADENCIA (FPS)" FontSize="10" Foreground="#D8DEE9" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtFps" Text="-- FPS" FontSize="20" FontWeight="Bold" Foreground="#88C0D0" Margin="0,4,0,0"/>
                            <TextBlock Text="Objetivo: 30-60 FPS" FontSize="10" Foreground="#4C566A"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Gesture & Intent Badge -->
                    <Border Grid.Column="4" Background="#1A1C28" CornerRadius="6" Padding="10" BorderBrush="#2E3440" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GESTO DETECTADO / ACCIÓN" FontSize="10" Foreground="#D8DEE9" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtGesture" Text="Ninguno (Esperando mano)" FontSize="15" FontWeight="Bold" Foreground="#EBCB8B" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TxtEngineState" Text="Estado: Inactivo" FontSize="10" Foreground="#81A1C1"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right: Settings & Tuning Controls -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,0,4,0">

                    <!-- Profile Selector -->
                    <GroupBox Header="PERFIL DE APLICACIÓN">
                        <StackPanel>
                            <TextBlock Text="Perfil Activo:" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbProfiles" Height="28" SelectionChanged="CmbProfiles_SelectionChanged" Background="#2E3440" Foreground="#ECEFF4"/>
                            <CheckBox x:Name="ChkAutoSwitch" Content="Auto-detectar ventana en primer plano" IsChecked="True" Margin="0,8,0,0" Foreground="#D8DEE9" Checked="ChkAutoSwitch_Changed" Unchecked="ChkAutoSwitch_Changed"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Tuning Parameters -->
                    <GroupBox Header="AJUSTE EN TIEMPO REAL (SAFETY &amp; INTENT)">
                        <StackPanel>
                            <!-- Dead Zone -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Zona Muerta (Dead Zone):" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtDeadZoneVal" Text="0.015" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldDeadZone" Minimum="0.005" Maximum="0.05" Value="0.015" SmallChange="0.001" LargeChange="0.005" ValueChanged="SldDeadZone_ValueChanged"/>

                            <!-- Mouse Multiplier -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sensibilidad Ratón:" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtSensitivityVal" Text="1.5x" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldSensitivity" Minimum="0.5" Maximum="4.0" Value="1.5" SmallChange="0.1" LargeChange="0.5" ValueChanged="SldSensitivity_ValueChanged"/>

                            <!-- Smoothing Alpha -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Suavizado EMA (Alpha):" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtSmoothingVal" Text="0.65" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldSmoothing" Minimum="0.1" Maximum="0.9" Value="0.65" SmallChange="0.05" LargeChange="0.1" ValueChanged="SldSmoothing_ValueChanged"/>

                            <!-- Hold Duration -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Duración Mínima (Hold):" FontSize="11"/>
                                <TextBlock Grid.Column="1" x:Name="TxtHoldVal" Text="120 ms" FontSize="11" Foreground="#88C0D0"/>
                            </Grid>
                            <Slider x:Name="SldHold" Minimum="50" Maximum="400" Value="120" SmallChange="10" LargeChange="50" ValueChanged="SldHold_ValueChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Visual Options -->
                    <GroupBox Header="VISUALIZACIÓN Y SEGURIDAD">
                        <StackPanel>
                            <CheckBox x:Name="ChkShowOverlay" Content="Superponer Esqueleto 3D (21 Landmarks)" IsChecked="True" Margin="0,4,0,4" Foreground="#D8DEE9"/>
                            <CheckBox x:Name="ChkEnableInput" Content="Habilitar Emisión SendInput (Control Real del SO)" IsChecked="True" Margin="0,4,0,4" Foreground="#A3BE8C" FontWeight="SemiBold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Quick Reference of Mappings -->
                    <GroupBox Header="MAPEO RÁPIDO DE GESTOS">
                        <StackPanel TextElement.FontSize="11">
                            <TextBlock Text="👉 Index Point: Movimiento de Ratón" Foreground="#D8DEE9" Margin="0,2"/>
                            <TextBlock Text="👌 Pinch: Clic Izquierdo (Drag si se sostiene)" Foreground="#D8DEE9" Margin="0,2"/>
                            <TextBlock Text="✊ Fist: Clic Central / Órbita 3D (Blender)" Foreground="#D8DEE9" Margin="0,2"/>
                            <TextBlock Text="✌️ Two Fingers: Clic Derecho / Menú Contextual" Foreground="#D8DEE9" Margin="0,2"/>
                            <TextBlock Text="🖐️ Open Hand: Activar / Pausar Control de Gestos" Foreground="#88C0D0" FontWeight="SemiBold" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Footer Status -->
        <Border Grid.Row="2" Background="#161822" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatusMessage" Text="Sistema listo para iniciar captura." FontSize="11" Foreground="#4C566A"/>
                <TextBlock Text="MVPGesture v1.0.0-phase1 • Arquitectura de 8 Proyectos" HorizontalAlignment="Right" FontSize="11" Foreground="#4C566A"/>
            </Grid>
        </Border>
    </Grid>
</Window>
